        <mxCell id="e_mi_api" edge="1" parent="1" source="mi" style="endArrow=none;html=1;strokeColor=#f85149;strokeWidth=1;dashed=1;dashPattern=6 6;" target="api">
          <mxGeometry relative="1" as="geometry" />
