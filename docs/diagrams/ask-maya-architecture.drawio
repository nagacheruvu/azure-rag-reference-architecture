        <mxCell id="e_web_api" edge="1" parent="1" source="web" style="endArrow=block;html=1;strokeColor=#58a6ff;strokeWidth=2;fontColor=#9fb6cc;fontSize=11;" target="api" value="HTTPS / SSE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_api_aoai" edge="1" parent="1" source="api" style="endArrow=block;html=1;strokeColor=#db6d28;strokeWidth=2;fontColor=#e3a06a;fontSize=11;" target="aoai" value="embed + chat">
          <mxGeometry relative="1" as="geometry" />
