        <mxCell id="e_search_storage" edge="1" parent="1" source="search" style="endArrow=block;html=1;strokeColor=#a371f7;strokeWidth=2;fontColor=#c0a3f0;fontSize=11;" target="storage" value="indexer pulls docs">
          <mxGeometry relative="1" as="geometry" />
