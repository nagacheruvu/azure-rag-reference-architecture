        <mxCell id="e_search_aoai" edge="1" parent="1" source="search" style="endArrow=block;html=1;strokeColor=#db6d28;strokeWidth=1;dashed=1;fontColor=#e3a06a;fontSize=10;" target="aoai" value="integrated&#xa;vectorization">
          <mxGeometry relative="1" as="geometry" />
