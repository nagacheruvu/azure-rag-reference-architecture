        <mxCell id="e_api_obs" edge="1" parent="1" source="api" style="endArrow=block;html=1;strokeColor=#d29922;strokeWidth=1;dashed=1;fontColor=#e3c878;fontSize=10;" target="obs" value="telemetry">
