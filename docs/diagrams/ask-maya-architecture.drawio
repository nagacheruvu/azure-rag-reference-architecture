          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_api_cosmos" edge="1" parent="1" source="api" style="endArrow=block;html=1;strokeColor=#a371f7;strokeWidth=2;fontColor=#c0a3f0;fontSize=11;" target="cosmos" value="history / count">
          <mxGeometry relative="1" as="geometry" />
