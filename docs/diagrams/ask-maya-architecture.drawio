<mxfile host="Electron" agent="askmaya-azure-redesign">
  <diagram name="Ask Maya — Solution Architecture" id="askmaya-arch-1">
    <mxGraphModel dx="1695" dy="1287" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" background="#0d1117" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontColor=#e6edf3;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" value="Ask Maya — Azure RAG Architecture (deployed: rg-askmaya-dev · canadacentral)" vertex="1">
          <mxGeometry height="34" width="1200" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontColor=#7d8590;fontSize=13;align=left;verticalAlign=middle;" value="Entra-only auth (no keys) · managed identity everywhere · serverless / scale-to-zero where possible" vertex="1">
          <mxGeometry height="24" width="1200" x="40" y="54" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#161b22;strokeColor=#30363d;fontColor=#7d8590;fontSize=11;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" value="LEGEND" vertex="1">
          <mxGeometry height="170" width="320" x="1360" y="92" as="geometry" />
        </mxCell>
        <mxCell id="legUser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f6feb;strokeColor=#388bfd;fontColor=#ffffff;fontSize=11;" value="Client / Edge" vertex="1">
          <mxGeometry height="26" width="120" x="1376" y="120" as="geometry" />
        </mxCell>
        <mxCell id="legApp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#238636;strokeColor=#2ea043;fontColor=#ffffff;fontSize=11;" value="Compute (Container Apps)" vertex="1">
          <mxGeometry height="26" width="170" x="1376" y="152" as="geometry" />
        </mxCell>
        <mxCell id="legAI" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bd561d;strokeColor=#db6d28;fontColor=#ffffff;fontSize=11;" value="AI / Retrieval" vertex="1">
          <mxGeometry height="26" width="110" x="1556" y="120" as="geometry" />
        </mxCell>
        <mxCell id="legData" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8957e5;strokeColor=#a371f7;fontColor=#ffffff;fontSize=11;" value="Data / State" vertex="1">
          <mxGeometry height="26" width="110" x="1556" y="152" as="geometry" />
        </mxCell>
        <mxCell id="legSec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#da3633;strokeColor=#f85149;fontColor=#ffffff;fontSize=11;" value="Identity / Security" vertex="1">
          <mxGeometry height="26" width="170" x="1376" y="184" as="geometry" />
        </mxCell>
        <mxCell id="legObs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9e6a03;strokeColor=#d29922;fontColor=#ffffff;fontSize=11;" value="Observability" vertex="1">
          <mxGeometry height="26" width="110" x="1556" y="184" as="geometry" />
        </mxCell>
        <mxCell id="legEdgeMI" parent="1" style="text;html=1;fontColor=#7d8590;fontSize=10;align=left;verticalAlign=top;" value="— · — managed-identity (Entra) auth&#xa;———— request / data flow" vertex="1">
          <mxGeometry height="40" width="300" x="1376" y="216" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f6feb;strokeColor=#388bfd;fontColor=#ffffff;fontSize=13;" value="&lt;b&gt;End User&lt;/b&gt;&lt;br&gt;&lt;font color=#cfe3ff size=1&gt;Browser over HTTPS&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="240" x="360" y="100" as="geometry" />
        </mxCell>
        <mxCell id="fd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#1f6feb;strokeColor=#388bfd;fontColor=#ffffff;fontSize=12;opacity=70;" value="&lt;b&gt;Azure Front Door (optional)&lt;/b&gt;&lt;br&gt;&lt;font color=#cfe3ff size=1&gt;Why: global entry, TLS, WAF, failover.&lt;br&gt;Off by default (deployFrontDoor=false).&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="320" x="320" y="190" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#238636;strokeColor=#2ea043;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Web — Blazor Server&lt;/b&gt;  (Container App · azweb…)&#xa;&lt;font color=#bdf0c2 size=1&gt;Why: stateful UI over a SignalR circuit; sticky sessions + min 1 replica keep a&#xa;conversation pinned to one replica. Runs as a container because App Service (B1/F1)&#xa;is blocked by this subscription&#39;s zero-VM quota.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="480" x="240" y="290" as="geometry" />
        </mxCell>
        <mxCell id="webGuards" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2a17;strokeColor=#2ea043;fontColor=#bdf0c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" value="&lt;b&gt;UI guard rails&lt;/b&gt;&#xa;• Summary mode only at launch (Precise hidden via /config flag)&#xa;• 500-char maxlength + live counter&#xa;• 5-question cap → ‘New thread’ reset&#xa;• High-load: input grayed out + ‘try later’ banner" vertex="1">
          <mxGeometry height="78" width="440" x="260" y="320" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#238636;strokeColor=#2ea043;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Chat API — FastAPI&lt;/b&gt;  (Container App · azca…)&#xa;&lt;font color=#bdf0c2 size=1&gt;Why: SSE token streaming, RAG orchestration, server-side conversation memory&#xa;via Responses API previous_response_id. Consumption scale (0→N) = pay per use.&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="560" x="200" y="470" as="geometry" />
        </mxCell>
        <mxCell id="apiGuards" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2a17;strokeColor=#2ea043;fontColor=#bdf0c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" value="&lt;b&gt;Server guard rails (authoritative)&lt;/b&gt;&#xa;• /config = single source of truth for limits + feature flags&#xa;• char cap + per-thread cap enforced server-side (limit event)&#xa;• mode enforcement: precise→summary fallback while flag off&#xa;• precise + no grounding ⇒ deterministic refusal (0 model tokens)&#xa;• 429 detection on embed + chat ⇒ ‘busy’ event (high-load)" vertex="1">
          <mxGeometry height="124" width="320" x="216" y="532" as="geometry" />
        </mxCell>
        <mxCell id="apiCost" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2a17;strokeColor=#2ea043;fontColor=#bdf0c2;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;" value="&lt;b&gt;Cost guard rails&lt;/b&gt;&#xa;• Semantic + exact cache&#xa;  (hit ⇒ 0 chat tokens)&#xa;• Prompt caching via stable&#xa;  per-mode instruction prefix&#xa;• previous_response_id ⇒ flat&#xa;  token cost as chat grows" vertex="1">
          <mxGeometry height="121" width="196" x="548" y="534" as="geometry" />
        </mxCell>
        <mxCell id="aoai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bd561d;strokeColor=#db6d28;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Azure OpenAI&lt;/b&gt;  (azcog…)&#xa;&lt;font color=#ffd9bf size=1&gt;• gpt-5.4-mini → chat / synthesis&#xa;• text-embedding-3-small → 1536-dim vectors&#xa;Why: managed, scalable inference; disableLocalAuth=true&#xa;(Entra-only). gpt-4o-mini has no quota on this sub.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="360" x="80" y="730" as="geometry" />
        </mxCell>
        <mxCell id="search" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bd561d;strokeColor=#db6d28;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Azure AI Search&lt;/b&gt;  (azsrch… · Basic)&#xa;&lt;font color=#ffd9bf size=1&gt;Why: hybrid (keyword + vector) retrieval with integrated&#xa;vectorization. Basic ≈ 15 GB storage fits the 10 GB start;&#xa;bump to Standard (S1) if vector quota is exceeded.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="370" x="470" y="730" as="geometry" />
        </mxCell>
        <mxCell id="cosmos" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8957e5;strokeColor=#a371f7;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Cosmos DB (serverless)&lt;/b&gt;  (azcosmos…)&#xa;&lt;font color=#e9ddff size=1&gt;Why: per-session chat turns + state (previous_response_id).&#xa;Powers the 5-question count. Serverless = pay-per-RU.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="360" x="80" y="900" as="geometry" />
        </mxCell>
        <mxCell id="storage" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8957e5;strokeColor=#a371f7;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Blob Storage&lt;/b&gt;  (azst…)&#xa;&lt;font color=#e9ddff size=1&gt;Why: source document corpus that the Search indexer&#xa;pulls, chunks &amp; vectorizes. Entra-only data plane.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="370" x="470" y="900" as="geometry" />
        </mxCell>
        <mxCell id="mi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#da3633;strokeColor=#f85149;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;User-Assigned Managed Identity&lt;/b&gt;&#xa;&lt;font color=#ffd1cf size=1&gt;Why: one Entra identity for both containers. RBAC to AOAI,&#xa;Search, Cosmos, Storage, ACR — no keys/secrets in app.&#xa;Note: SP data-plane is blocked tenant-wide; MI is required.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="900" y="470" as="geometry" />
        </mxCell>
        <mxCell id="kv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#da3633;strokeColor=#f85149;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Key Vault&lt;/b&gt;  (azkv…)&#xa;&lt;font color=#ffd1cf size=1&gt;Why: vault for any future secrets/certs; RBAC-gated.&lt;/font&gt;" vertex="1">
          <mxGeometry height="64" width="360" x="900" y="600" as="geometry" />
        </mxCell>
        <mxCell id="acr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#da3633;strokeColor=#f85149;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;Container Registry&lt;/b&gt;  (azcr…)&#xa;&lt;font color=#ffd1cf size=1&gt;Why: stores API + Web images; AcrPull via MI. Remote&#xa;build (no local Docker needed).&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="360" x="900" y="684" as="geometry" />
        </mxCell>
        <mxCell id="obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9e6a03;strokeColor=#d29922;fontColor=#ffffff;fontSize=12;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;App Insights + Log Analytics&lt;/b&gt;  (azappi… / azlog…)&#xa;&lt;font color=#ffeec2 size=1&gt;Why: distributed traces, request/error telemetry and container&#xa;console logs for both apps — the basis for the high-load (429) signal&#xa;and production troubleshooting.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="900" y="790" as="geometry" />
        </mxCell>
        <mxCell id="apim" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#1f6feb;strokeColor=#388bfd;fontColor=#ffffff;fontSize=12;opacity=70;align=center;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;APIM + Service Bus (optional)&lt;/b&gt;&#xa;&lt;font color=#cfe3ff size=1&gt;Why: gateway token-rate cap / async ingestion. Off by default&#xa;(deployApim / deployServiceBus = false) to keep dev cheap.&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="900" y="100" as="geometry" />
        </mxCell>
        <mxCell id="e_user_fd" edge="1" parent="1" source="user" style="endArrow=block;html=1;strokeColor=#58a6ff;strokeWidth=2;dashed=1;" target="fd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fd_web" edge="1" parent="1" source="fd" style="endArrow=block;html=1;strokeColor=#58a6ff;strokeWidth=2;" target="web">
