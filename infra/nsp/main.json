            },
            {
              "type": "Microsoft.Network/networkSecurityPerimeters/profiles/accessRules",
              "apiVersion": "2024-07-01",
              "name": "[format('{0}/{1}/{2}', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile', 'allow-outbound-fqdns')]",
              "properties": {
                "direction": "Outbound",
                "fullyQualifiedDomainNames": [
                  "[format('{0}.openai.azure.com', format('foundry{0}', parameters('resourceToken')))]",
                  "[format('{0}.cognitiveservices.azure.com', format('foundry{0}', parameters('resourceToken')))]",
                  "[format('{0}.search.windows.net', format('srch{0}', parameters('resourceToken')))]"
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts', format('foundry{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile')]",
                "[resourceId('Microsoft.Search/searchServices', format('srch{0}', parameters('resourceToken')))]"
              ]
            },
            {
              "type": "Microsoft.Network/networkSecurityPerimeters/resourceAssociations",
              "apiVersion": "2024-07-01",
              "name": "[format('{0}/{1}', format('nsp-{0}', parameters('resourceToken')), 'assoc-foundry')]",
              "properties": {
                "accessMode": "[parameters('accessMode')]",
                "privateLinkResource": {
                  "id": "[resourceId('Microsoft.CognitiveServices/accounts', format('foundry{0}', parameters('resourceToken')))]"
                },
                "profile": {
                  "id": "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile')]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts', format('foundry{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.Network/networkSecurityPerimeters', format('nsp-{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile')]"
              ]
            },
            {
              "type": "Microsoft.Network/networkSecurityPerimeters/resourceAssociations",
              "apiVersion": "2024-07-01",
              "name": "[format('{0}/{1}', format('nsp-{0}', parameters('resourceToken')), 'assoc-search')]",
              "properties": {
                "accessMode": "[parameters('accessMode')]",
                "privateLinkResource": {
                  "id": "[resourceId('Microsoft.Search/searchServices', format('srch{0}', parameters('resourceToken')))]"
                },
                "profile": {
                  "id": "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile')]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityPerimeters', format('nsp-{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile')]",
                "[resourceId('Microsoft.Search/searchServices', format('srch{0}', parameters('resourceToken')))]"
              ]
            },
            {
              "type": "Microsoft.Insights/diagnosticSettings",
              "apiVersion": "2021-05-01-preview",
              "scope": "[resourceId('Microsoft.Network/networkSecurityPerimeters', format('nsp-{0}', parameters('resourceToken')))]",
              "name": "nsp-alllogs",
              "properties": {
                "workspaceId": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('resourceToken')))]",
                "logAnalyticsDestinationType": "Dedicated",
                "logs": [
                  {
                    "categoryGroup": "allLogs",
                    "enabled": true
                  }
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('resourceToken')))]",
                "[resourceId('Microsoft.Network/networkSecurityPerimeters', format('nsp-{0}', parameters('resourceToken')))]"
              ]
            }
          ],
          "outputs": {
            "foundryEndpoint": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', format('foundry{0}', parameters('resourceToken'))), '2024-10-01').endpoint]"
            },
            "searchEndpoint": {
              "type": "string",
              "value": "[format('https://{0}.search.windows.net', format('srch{0}', parameters('resourceToken')))]"
            },
            "nspId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/networkSecurityPerimeters', format('nsp-{0}', parameters('resourceToken')))]"
            },
            "nspProfileId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Network/networkSecurityPerimeters/profiles', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile')]"
            },
            "logAnalyticsWorkspaceCustomerId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('resourceToken'))), '2023-09-01').customerId]"
            },
            "logAnalyticsWorkspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', format('log-{0}', parameters('resourceToken')))]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', format('rg-{0}', parameters('environmentName')))]"
      ]
    }
