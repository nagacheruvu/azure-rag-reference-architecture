  "outputs": {
    "foundryEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Foundry (AIServices) data-plane endpoint."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'foundry-nsp-resources'), '2025-04-01').outputs.foundryEndpoint.value]"
    },
    "searchEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Azure AI Search data-plane endpoint (secondary region)."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'foundry-nsp-resources'), '2025-04-01').outputs.searchEndpoint.value]"
    },
    "nspId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the network security perimeter."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'foundry-nsp-resources'), '2025-04-01').outputs.nspId.value]"
    },
    "nspProfileId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the NSP profile both resources are associated with."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'foundry-nsp-resources'), '2025-04-01').outputs.nspProfileId.value]"
    },
    "logAnalyticsWorkspaceCustomerId": {
      "type": "string",
      "metadata": {
        "description": "Customer-immutable ID of the Log Analytics workspace holding NspAccessLogs."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'foundry-nsp-resources'), '2025-04-01').outputs.logAnalyticsWorkspaceCustomerId.value]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Log Analytics workspace holding NspAccessLogs."
      },
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, format('rg-{0}', parameters('environmentName'))), 'Microsoft.Resources/deployments', 'foundry-nsp-resources'), '2025-04-01').outputs.logAnalyticsWorkspaceId.value]"
    },
    "accessMode": {
      "type": "string",
      "metadata": {
        "description": "Effective access mode applied to the associations."
      },
      "value": "[parameters('accessMode')]"
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group the demo was deployed into."
      },
      "value": "[format('rg-{0}', parameters('environmentName'))]"
    }
  }
}