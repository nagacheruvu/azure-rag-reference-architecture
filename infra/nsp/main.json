              "dependsOn": [
                "[resourceId('Microsoft.Network/networkSecurityPerimeters', format('nsp-{0}', parameters('resourceToken')))]"
              ]
            },
            {
              "condition": "[variables('hasClientIp')]",
              "type": "Microsoft.Network/networkSecurityPerimeters/profiles/accessRules",
              "apiVersion": "2024-07-01",
              "name": "[format('{0}/{1}/{2}', format('nsp-{0}', parameters('resourceToken')), 'foundry-search-profile', 'allow-inbound-client-ip')]",
              "properties": {
                "direction": "Inbound",
